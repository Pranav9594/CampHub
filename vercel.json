{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "source": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "source": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "source": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
